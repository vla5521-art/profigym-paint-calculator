NODE_ENV=production
APP_PUBLIC_URL=https://example.invalid
APP_ALLOWED_ORIGINS=https://example.invalid
TLS_DOMAIN=example.invalid
TRUST_PROXY=true
PROFIGYM_ACCESS_TOKEN=replace-with-at-least-32-random-bytes
PROFIGYM_METRICS_TOKEN=replace-with-separate-random-token
PROFIGYM_IMAGE=ghcr.io/owner/profigym-calculator:sha-REPLACE
IMAGE_VCS_REF=REPLACE
CAD_STORAGE_ROOT=/data
CAD_DATABASE_PATH=/data/database/profigym.sqlite
CAD_PROCESSING_MODE=queue
CAD_WORKER_REQUIRED=true
CAD_WORKER_CONCURRENCY=1
CAD_QUEUE_POLL_INTERVAL_MS=500
CAD_JOB_TIMEOUT_MS=300000
CAD_IMPORT_TIMEOUT_MS=120000
CAD_CONTACT_TIMEOUT_MS=120000
CAD_FEATURE_TIMEOUT_MS=120000
CAD_VIEWER_TIMEOUT_MS=90000
CAD_REPORT_TIMEOUT_MS=30000
CAD_JOB_HEARTBEAT_INTERVAL_MS=5000
CAD_JOB_STALE_AFTER_MS=30000
CAD_JOB_MAX_ATTEMPTS=2
CAD_MAX_UPLOAD_BYTES=52428800
CAD_MAX_JSON_BODY_BYTES=262144
CAD_MAX_PREVIEW_BYTES=2097152
CAD_VIEWER_MAX_TRIANGLES=750000
CAD_SOURCE_RETENTION_DAYS=30
CAD_MESH_RETENTION_DAYS=90
CAD_PREVIEW_RETENTION_DAYS=30
CAD_REPORT_RETENTION_DAYS=30
CAD_FAILED_JOB_RETENTION_DAYS=14
CAD_TEMP_FILE_MAX_AGE_MINUTES=60
CAD_CLEANUP_INTERVAL_MINUTES=60
CAD_ANTIVIRUS_ENABLED=false
CAD_ANTIVIRUS_HOST=clamav
CAD_ANTIVIRUS_PORT=3310
CAD_ANTIVIRUS_TIMEOUT_MS=10000
CAD_ANTIVIRUS_FAIL_MODE=closed
LOG_LEVEL=info
LOG_FORMAT=json
LOG_REDACT_FIELDS=authorization,cookie,token,password,secret,stack
