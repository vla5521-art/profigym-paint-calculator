{
  "name": "profigym-paint-calculator",
  "private": true,
  "version": "2.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "npm run verify:template",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:migration": "node --experimental-strip-types --test tests/migration.test.mjs",
    "test": "npm run test:node && npm run test:frontend && node scripts/write-unit-results.mjs",
    "test:node": "node scripts/run-node-tests.mjs",
    "test:frontend": "vitest run --reporter=default --reporter=json --outputFile.json=diagnostic-reports/vitest-results.json",
    "test:golden": "node --test tests/golden/*.test.mjs",
    "test:regression": "node scripts/run-regression.mjs",
    "regression:update": "UPDATE_REGRESSION=1 node scripts/run-regression.mjs",
    "test:determinism": "node scripts/test-determinism.mjs",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:concurrency": "node --test tests/concurrency/*.test.mjs",
    "test:memory": "node --expose-gc scripts/test-memory.mjs",
    "test:soak": "node --expose-gc scripts/test-soak.mjs",
    "test:report": "node scripts/generate-test-report.mjs",
    "test:xlsx": "node --experimental-strip-types --test tests/xlsx-archive.test.mjs",
    "verify:template": "node --experimental-strip-types scripts/verify-template-packaging.mjs",
    "dev:api": "node server/index.js",
    "dev:full": "concurrently -k \"npm:dev:api\" \"npm:dev\"",
    "test:cad": "node --experimental-strip-types --test tests/cad-*.test.mjs tests/cad-*.integration.mjs",
    "generate:cad-fixtures": "node scripts/generate-cad-fixtures.mjs",
    "generate:contact-fixtures": "node scripts/generate-contact-fixtures.mjs",
    "generate:feature-fixtures": "node scripts/generate-feature-fixtures.mjs",
    "fixtures:golden": "node scripts/generate-golden-models.mjs",
    "smoke:cad": "node scripts/smoke-test.mjs",
    "smoke:live": "node scripts/run-live-smoke.mjs",
    "smoke:contacts": "node scripts/smoke-contacts.mjs",
    "benchmark:contacts": "node scripts/benchmark-contacts.mjs",
    "smoke:features": "node scripts/smoke-features.mjs",
    "benchmark:features": "node scripts/benchmark-features.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:status": "node scripts/db-status.mjs",
    "db:integrity": "node scripts/db-integrity.mjs",
    "db:checkpoint": "node scripts/db-checkpoint.mjs",
    "smoke:workflow": "node --test tests/stage5-workflow.integration.mjs",
    "benchmark:viewer": "node scripts/benchmark-viewer.mjs",
    "benchmark:persistence": "node scripts/benchmark-persistence.mjs",
    "benchmark:full": "node scripts/benchmark-suite.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore:test": "node --test tests/persistence/backup-restore.test.mjs",
    "backup:create": "node scripts/backup-cli.mjs create",
    "backup:list": "node scripts/backup-cli.mjs list",
    "backup:verify": "node scripts/backup-cli.mjs verify",
    "backup:restore:test": "node scripts/backup-cli.mjs restore-test",
    "backup:cleanup": "node scripts/backup-cli.mjs cleanup",
    "storage:cleanup": "node scripts/storage-cleanup.mjs",
    "storage:cleanup:dry-run": "node scripts/storage-cleanup.mjs --dry-run",
    "security:audit": "node scripts/security-audit.mjs",
    "security:sbom": "node scripts/security-sbom.mjs",
    "security:licenses": "node scripts/security-licenses.mjs",
    "security:secrets": "node scripts/security-secrets.mjs",
    "ci:actionlint": "node scripts/actionlint.mjs",
    "ci:validate": "npm run ci:actionlint && node scripts/validate-actions.mjs",
    "prod:build": "docker compose -f compose.yml -f compose.production.yml build",
    "prod:up": "docker compose -f compose.yml -f compose.production.yml up -d",
    "prod:down": "docker compose -f compose.yml -f compose.production.yml down --remove-orphans",
    "prod:logs": "docker compose -f compose.yml -f compose.production.yml logs -f --tail=200",
    "prod:status": "docker compose -f compose.yml -f compose.production.yml ps",
    "prod:smoke": "npm run smoke:production",
    "prod:rollback:test": "npm run smoke:rollback",
    "prod:local:verify": "node scripts/run-production-like.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "smoke:observability": "node scripts/observability-smoke.mjs",
    "smoke:backup": "node scripts/backup-smoke.mjs",
    "smoke:rollback": "node scripts/rollback-smoke.mjs",
    "e2e:prepare": "node scripts/prepare-e2e-chromium.mjs",
    "e2e": "npm run e2e:prepare && PLAYWRIGHT_BROWSERS_PATH=.tmp/pw-browsers playwright test",
    "e2e:chromium": "npm run e2e:prepare && E2E_SUITE=functional PLAYWRIGHT_BROWSERS_PATH=.tmp/pw-browsers playwright test --project=chromium --grep-invert @a11y",
    "e2e:headed": "npm run e2e:prepare && PLAYWRIGHT_BROWSERS_PATH=.tmp/pw-browsers playwright test --headed --project=chromium",
    "e2e:report": "playwright show-report",
    "e2e:a11y": "npm run e2e:prepare && E2E_SUITE=a11y PLAYWRIGHT_BROWSERS_PATH=.tmp/pw-browsers playwright test --project=chromium --grep @a11y"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "occt-wasm": "^3.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "actionlint": "^2.0.6",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@sparticuz/chromium": "^149.0.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  }
}
