{
  "name": "profigym-paint-calculator",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:migration": "node --experimental-strip-types --test tests/migration.test.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:xlsx": "node --experimental-strip-types --test tests/xlsx-archive.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  }
}
